{
  "name": "font-converter",
  "version": "0.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bundle:assets": "mkdir -p ./bundle; ln -nf ./src/*.html ./bundle; ln -nf ./src/*.css ./bundle; ln -sf ../fonts ./bundle/; ln -sf ../icons ./bundle/",
    "serve": "npm run bundle:assets && esbuild --bundle ./src/index.js --outdir=./bundle --format=esm --servedir=./bundle --watch",
    "bundle": "npm run bundle:assets && esbuild --bundle ./src/index.js --outdir=./bundle --format=esm",
    "test": "node --test ./test/*.test.js",
    "cli": "node ./src/cli.js"
  },
  "author": "Alexander K",
  "license": "GPL-3.0",
  "dependencies": {
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "type": "module",
  "bin": {
    "font2bitmap": "./src/cli.js"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  }
}
